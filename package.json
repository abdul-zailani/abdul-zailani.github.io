{
  "name": "abdul-zailani-github-io",
  "version": "1.0.0",
  "description": "Personal website & SRE blog",
  "scripts": {
    "build:css": "tailwindcss -i assets/css/input.css -o assets/css/tailwind.min.css --minify",
    "lint:content": "node scripts/sanitize-content.mjs",
    "optimize:images": "node scripts/optimize-images.mjs",
    "build:search": "pagefind --site _site",
    "minify:html": "html-minifier-terser --input-dir _site --output-dir _site --file-ext html --collapse-whitespace --remove-comments --minify-js true --minify-css true",
    "build:slides": "marp --no-stdin --theme-set _slides/theme.css --pdf _slides/template-carousel.md -o assets/slides/template-carousel.pdf",
    "build": "npm run build:css && npm run optimize:images",
    "postbuild:site": "npm run build:search && npm run minify:html"
  },
  "devDependencies": {
    "@marp-team/marp-cli": "^4.5.0",
    "@tailwindcss/container-queries": "^0.1.1",
    "@tailwindcss/forms": "^0.5.10",
    "glob": "^13.0.6",
    "gray-matter": "^4.0.3",
    "html-minifier-terser": "^7.2.0",
    "pagefind": "^1.5.2",
    "remark-parse": "^11.0.0",
    "remark-stringify": "^11.0.0",
    "sharp": "^0.35.4",
    "tailwindcss": "^3.4.19",
    "unified": "^11.0.5",
    "unist-util-visit": "^5.1.0"
  }
}
